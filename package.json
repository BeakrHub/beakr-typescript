{
  "name": "@beakr/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Beakr public API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeakrHub/beakr-typescript.git"
  },
  "homepage": "https://github.com/BeakrHub/beakr-typescript#readme",
  "bugs": {
    "url": "https://github.com/BeakrHub/beakr-typescript/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "regen": "npm run generate && npm run typecheck && npm run build",
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:node-smoke": "node --test test-node/runtime-smoke.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^3.2.0",
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
